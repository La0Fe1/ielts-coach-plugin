{
  "name": "ielts-speaking-coach",
  "displayName": "IELTS Speaking Coach",
  "description": "Local IELTS speaking practice: examiner, instant correction, pronunciation heat map and lesson reports, powered by a local daemon.",
  "version": "0.1.0",
  "publisher": "ielts-coach-local",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Education"],
  "keywords": ["ielts", "speaking", "english", "pronunciation", "mcp"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "ieltsCoach.openPanel", "title": "IELTS: 打开口语教练面板", "category": "IELTS" },
      { "command": "ieltsCoach.openInBrowser", "title": "IELTS: 在浏览器打开（麦克风更稳）", "category": "IELTS" },
      { "command": "ieltsCoach.startDaemon", "title": "IELTS: 启动本地守护进程", "category": "IELTS" },
      { "command": "ieltsCoach.showStatus", "title": "IELTS: 检查守护进程状态", "category": "IELTS" }
    ],
    "configuration": {
      "title": "IELTS Speaking Coach",
      "properties": {
        "ieltsCoach.port": { "type": "number", "default": 8765, "description": "本地守护进程端口" },
        "ieltsCoach.pythonPath": { "type": "string", "default": "", "description": "守护进程使用的 Python（留空自动探测 .venv）" },
        "ieltsCoach.projectRoot": { "type": "string", "default": "", "description": "ielts-coach-plugin 项目目录（留空自动探测）" }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3"
  }
}
