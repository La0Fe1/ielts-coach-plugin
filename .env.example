# ============================================================================
#  雅思口语教练 v2.1.0 · 环境变量示例
#  复制本文件为 .env 再按需填写；留空的项 = 不启用（更安全）。
#  网页与 MCP 共用同一个端口：浏览器打开 http://localhost:3000，
#  MCP Streamable HTTP 端点是 http://localhost:3000/mcp。
# ============================================================================

# ---------------- 基础 ----------------
# 服务端口（网页 + MCP HTTP 同一个端口）
PORT=3000

# ---------------- 站长模式（朋友用口令即可，不用自带 Key） ----------------
# 设置后，朋友在设置里输入这个口令就能用你配置的额度
ACCESS_CODE=
# 只有你确实想把服务端 Key 公开给任何人时，才设为 true（默认 false，更安全）
ALLOW_PUBLIC_HOST_KEY=false

# ---------------- 实时语音服务商（至少配一个，或让用户自带 Key） ----------------
# 阿里云百炼（国内直连，推荐）
DASHSCOPE_API_KEY=
# 可选：专属 Workspace，填了会走 wss://<workspace>.cn-beijing.maas.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=
# 可选：Workspace 专属 Key（不填则用上面的 DASHSCOPE_API_KEY）
DASHSCOPE_WORKSPACE_API_KEY=

# Google Gemini Live（海外直连）
GEMINI_API_KEY=

# OpenAI 官方或中转站
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：副轨文本精批单独用 DeepSeek（更省钱）
DEEPSEEK_API_KEY=

# ---------------- MCP 全生态接入（豆包 / dsh / Codex / Claude / Cursor） ----------------
# MCP Streamable HTTP 地址：http(s)://<你的域名>/mcp（本机默认 http://127.0.0.1:3000/mcp）
# 设置 MCP_TOKEN 后，/mcp 与多用户同步接口要求请求头 Authorization: Bearer <MCP_TOKEN>；
# 不设置时仅放行本机 127.0.0.1 / ::1 / localhost，公网访问直接 401。
MCP_TOKEN=

# 多用户隔离开关。true：公网普通访客的课程只留在自己浏览器 IndexedDB，
# 不写入服务端共享 store.json；只有携带 MCP_TOKEN 或专属 ?lesson=<id> 链接的
# 客户端才读写共享存储。单机自用 / 只给自己用请保持 false（默认）。
MULTI_USER_MODE=false

# MCP 与网页共享的数据目录（默认 ~/.ielts-coach，store.json 存在这里）。
# 容器/云平台建议指向持久化卷，例如 /data 或 /app/data。
IELTS_COACH_DATA_DIR=

# create_lesson 返回给用户点开的网页地址前缀。
# 本地可不填（默认 http://127.0.0.1:<PORT>）；部署到云端时填 https://你的域名，
# 这样 AI 工具拉起的就是公网可访问的课程链接。
PUBLIC_BASE_URL=
