# ===== 可选：站长模式（朋友用口令即可，不用自带 Key）=====
# 设置后，朋友在设置里输入这个口令就能用你配置的额度
ACCESS_CODE=
# 只有你确实想把服务端 Key 公开给任何人时，才设为 true（默认 false，更安全）
ALLOW_PUBLIC_HOST_KEY=false

# 阿里云百炼（国内直连，推荐）
DASHSCOPE_API_KEY=
# 可选：专属 Workspace，填了会走 wss://<workspace>.cn-beijing.maas.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=

# Google Gemini Live（海外直连）
GEMINI_API_KEY=

# OpenAI 官方或中转站
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：副轨文本精批单独用 DeepSeek（更省钱）
DEEPSEEK_API_KEY=

# 服务端口
PORT=3000
